# ClaudeCut Proxy Environment Settings
HOST=127.0.0.1
PORT=8000

# Upstream Anthropic API configuration
# (If not provided here, ClaudeCut will forward the x-api-key provided in client requests)
ANTHROPIC_API_KEY=

# Optimization Toggles
ENABLE_AUTO_PROMPT_CACHING=true
ENABLE_CONTEXT_PRUNING=true
ENABLE_SMART_ROUTING=false
ENABLE_RESPONSE_CACHE=true

# Prompt Caching minimum token threshold (Anthropic requires 1024+ tokens for prompt caching)
PROMPT_CACHE_MIN_TOKENS=1024

# Smart Routing Configuration
# When enabled, queries matching simple tasks are automatically routed to Haiku
CHEAP_FALLBACK_MODEL=claude-3-5-haiku-20241022
FLAGSHIP_MODEL=claude-3-7-sonnet-20250219

# Analytics Database (SQLite)
DATABASE_PATH=claudecut_analytics.db
